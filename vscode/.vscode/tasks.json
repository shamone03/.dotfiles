{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "package_folder",
            "description": "The shared library package to build",
            "type": "promptString",
            "default": "atlas.pre-develop"
        }
    ],
    "tasks": [
        {
            "label": "Install",
            "command": "just",
            "args": ["install"],
            "problemMatcher": []
        },
        {
            "label": "Update",
            "command": "just",
            "args": ["update"],
            "problemMatcher": []
        },
        {
            "label": "Build",
            "command": "just",
            "args": ["build"],
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build And Sym-link Dependency",
            "options": {
                "cwd": "${env:projects}/${input:package_folder}"
            },
            "command": "just",
            "args": ["build", "all", "link", "${workspaceFolderBasename}"],
            "problemMatcher": []
        },
        {
            "label": "Debug With Deps",
            "dependsOn": ["Build And Sym-link Dependency", "Build"]
        },
        {
            "label": "Rebuild",
            "command": "just",
            "args": ["rebuild"],
            "problemMatcher": []
        },
        {
            "label": "Update and Rebuild",
            "command": "just",
            "args": ["rerebuild"],
            "problemMatcher": []
        }
    ]
}
