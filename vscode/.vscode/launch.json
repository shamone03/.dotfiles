{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach AIMS",
            "type": "cppvsdbg",
            "request": "attach",
            "program": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug/aims.exe"
        },
        {
            "name": "Attach SCS",
            "type": "cppvsdbg",
            "request": "attach",
            "program": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug/sensor-communication-service.exe"
        },
        {
            "name": "Debug AIMS",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Build",
            "program": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug/AIMS.exe",
            "cwd": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug"
        },
        {
            "name": "Debug SCS",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Build",
            "program": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug/sensor-communication-service.exe",
            "cwd": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug AIMS With Deps",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Debug With Deps",
            "program": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug/AIMS.exe",
            "cwd": "${env:project_builds}/${env:SHMN_CONAN_VENV_NAME}/track-sdk/build/msvc194/Debug"
        },
        {
            "name": "Launch",
            "type": "cppvsdbg",
            "preLaunchTask": "Build",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.getLaunchTargetDirectory}"
        },
        {
            "name": "Launch With Deps",
            "type": "cppvsdbg",
            "preLaunchTask": "Debug With Deps",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.getLaunchTargetDirectory}"
        }
    ]
